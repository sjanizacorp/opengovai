PORT=3000
OPENGOVAI_LOCAL_LOGIN=true
OPENGOVAI_SECURE_COOKIE=false

# Set for remote TLS ingress, OIDC, or external PostgreSQL.
# OPENGOVAI_PUBLIC_URL=https://governance.example.com
# OPENGOVAI_DATABASE_URL=
# OPENGOVAI_OIDC_ISSUER=
# OPENGOVAI_OIDC_CLIENT_ID=
# OPENGOVAI_OIDC_CLIENT_SECRET=
# OPENGOVAI_OIDC_STATE_KEY=
# OPENGOVAI_OIDC_SUBJECT_CLAIM=sub

# Optional unit-scoped directory provisioning.
# OPENGOVAI_SCIM_TOKEN=
# OPENGOVAI_SCIM_UNIT=
# OPENGOVAI_SCIM_ROLE=contributor

# Optional operational metrics and audit forwarding.
# OPENGOVAI_METRICS_TOKEN=
# OPENGOVAI_AUDIT_DESTINATION=
# OPENGOVAI_AUDIT_URL=
# OPENGOVAI_AUDIT_TOKEN=

# Optional policy drafting engines. Use a quoted JSON array in .env.
# Select approved endpoints in Policies > Policy AI settings.
# OPENGOVAI_POLICY_AI_ALLOW_PUBLIC=true
# OPENGOVAI_POLICY_AI_ENDPOINTS='[]'
# Set a persistent Fernet key to enable saving API credentials from the UI.
# OPENGOVAI_POLICY_AI_STATE_KEY=
# Optional legacy, environment-managed connections.
# OPENGOVAI_POLICY_AI_ENGINES='[]'
